{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "target": {
    "model_name": "DeepSeek-V3-671B",
    "architecture": "MoE",
    "framework": "JAX/MaxText",
    "model_evidence_url": "https://source.corp.google.com/piper///depot/google3/experimental/users/ranran/deepseek/launch_conv_bf16_mlperf_mtp.sh",
    "reference_implementation": {
      "source_url": "https://paste.googleplex.com/6134085815238656",
      "gpu_ref_convergence_steps": 47,
      "tpu_baseline_convergence_steps": 53
    }
  },
  "hardware": {
    "accelerator": "TPU v7x",
    "chip_count": 8192,
    "mesh_shape": [16, 16, 32],
    "cluster_name": "bodaborg-super-tpu7x-y6k",
    "gcp_project": "cloud-tpu-multipod-dev",
    "zone": "us-central1",
    "sub_slices_for_testing": [256, 2048, 4096, 8192]
  },
  "execution": {
    "backend": "xpk",
    "cluster_or_zone": "us-central1/bodaborg-super-tpu7x-y6k",
    "project": "cloud-tpu-multipod-dev",
    "launch_script": "//depot/google3/experimental/users/ranran/deepseek/launch_conv_bf16_mlperf_mtp.sh"
  },
  "workload": {
    "regime": "training",
    "global_batch_size": 16384,
    "per_device_batch_size": 1,
    "prompt_length_tokens": 4096,
    "output_length_tokens": 4096,
    "batch_size": 1,
    "target_precision": {
      "weights": "fp8",
      "activations": "bf16",
      "kv_cache": "bf16",
      "moe_routing": "fp8"
