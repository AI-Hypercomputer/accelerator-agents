  },
  "objective": {
    "primary_metric": "tokens_per_sec_per_chip",
    "optimization_goal": "maximize",
    "baseline_tps_per_chip": 1600.0,
    "target_tps_per_chip": 2500.0,
    "target_improvement_pct": 56.25,
    "primary_focus_areas": [
      "FSDP and EP collective communication overlap",
      "8k topology and mesh configuration tuning",
      "Mitigate collective cost at per-device batch size = 1",
      "Close convergence gap to match Nvidia 47-step reference"
    ],
    "constraints": {
      "max_convergence_steps": 47,
      "correctness_gate": {
        "numeric_tolerance": "bf16",
        "eval_benchmark": "MLPerf-6.1-DSv3-Training-Convergence",
        "target_convergence_loss": 2.15,
        "max_accuracy_drop_pp": 0.0
      }
    }
  }
}
